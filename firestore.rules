rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function company(companyId) { return get(/databases/$(database)/documents/Companies/$(companyId)); }
    function isOwner(companyId) { return signedIn() && company(companyId).data.ownerUid == request.auth.uid; }
    function employeeId() { return request.auth.token.companyEmployeeId; }
    function employee(companyId) { return get(/databases/$(database)/documents/Companies/$(companyId)/Usermanagement/$(employeeId())); }
    function companyMember(companyId) { return signedIn() && (isOwner(companyId) || request.auth.token.companyId == companyId); }
    function active(companyId) { return isOwner(companyId) || (companyMember(companyId) && (!('access' in employee(companyId).data) || ((!('loginEnabled' in employee(companyId).data.access) || employee(companyId).data.access.loginEnabled != false) && (!('status' in employee(companyId).data.access) || employee(companyId).data.access.status in ['active', 'Active']))) && (!('loginEnabled' in employee(companyId).data) || employee(companyId).data.loginEnabled != false) && (!('status' in employee(companyId).data) || employee(companyId).data.status in ['active', 'Active']) && (!('employment' in employee(companyId).data) || !('status' in employee(companyId).data.employment) || employee(companyId).data.employment.status in ['active', 'Active'])); }
    function has(companyId, permission) { return isOwner(companyId) || (active(companyId) && permission in employee(companyId).data.access.effectivePermissions); }
    function roleId(companyId) { return isOwner(companyId) ? 'owner' : employee(companyId).data.access.roleId; }
    function managerScope(companyId) { return isOwner(companyId) || (active(companyId) && roleId(companyId) != 'employee'); }
    function ownExpense(companyId, data) {
      return active(companyId)
        && (data.get('employeeFirestoreId', '') == employeeId()
          || data.get('employeeId', '') == employee(companyId).data.get('employeeId', ''));
    }
    // Firestore Rules does not support substring(); preserve the YYYY-MM period key
    // using the supported split/index/string-concatenation operations.
    function expensePeriodId(date) { return date.split('-')[0] + '-' + date.split('-')[1]; }
    function canWrite(companyId, module) { return has(companyId, module + '.manage') || (request.method == 'create' && has(companyId, module + '.create')) || (request.method == 'update' && has(companyId, module + '.edit')) || (request.method == 'delete' && has(companyId, module + '.delete')); }
    function ownNotificationNamespace(companyId, userId) {
      return signedIn() && userId == request.auth.uid && companyMember(companyId);
    }
    function notificationAudience(companyId) {
      return isOwner(companyId) || (has(companyId, 'notifications.view')
        && resource.data.get('companyId', '') == companyId
        && resource.data.get('audienceKeys', []).hasAny([
          'user:' + request.auth.uid,
          'user:' + employeeId(),
          'role:' + roleId(companyId),
          'company:all'
        ])
        && (!resource.data.get('audienceKeys', []).hasAny(['company:all'])
          || resource.data.get('module', '') == 'announcement'
          || resource.data.get('broadcast', false) == true));
    }
    function validNotificationStateValues() {
      return (!('isRead' in request.resource.data) || request.resource.data.isRead is bool)
        && (!('readAt' in request.resource.data) || request.resource.data.readAt is timestamp)
        && (!('isArchived' in request.resource.data) || request.resource.data.isArchived is bool)
        && (!('isDeleted' in request.resource.data) || request.resource.data.isDeleted is bool)
        && (!('isPinned' in request.resource.data) || request.resource.data.isPinned is bool)
        && request.resource.data.updatedAt == request.time;
    }
    function validNotificationStateCreate() {
      return request.resource.data.keys().hasOnly(['isRead', 'readAt', 'isArchived', 'isDeleted', 'isPinned', 'updatedAt'])
        && validNotificationStateValues();
    }
    function validNotificationStateUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isRead', 'readAt', 'isArchived', 'isDeleted', 'isPinned', 'updatedAt'])
        && validNotificationStateValues();
    }
    function ownAdvance(companyId, data) {
      return active(companyId)
        && (data.get('employeeFirestoreId', '') == employeeId()
          || data.get('employeeId', '') == employee(companyId).data.get('employeeId', ''));
    }
    function canonicalEmployeeAdvanceRead(companyId, data) {
      return request.auth != null
        && request.auth.token.companyId == companyId
        && data.employeeFirestoreId == request.auth.token.companyEmployeeId
        && exists(/databases/$(database)/documents/Companies/$(companyId)/Usermanagement/$(request.auth.token.companyEmployeeId))
        && get(/databases/$(database)/documents/Companies/$(companyId)/Usermanagement/$(request.auth.token.companyEmployeeId)).data.access.loginEnabled == true
        && get(/databases/$(database)/documents/Companies/$(companyId)/Usermanagement/$(request.auth.token.companyEmployeeId)).data.access.status == 'active';
    }
    function ownPayroll(companyId, data) {
      return active(companyId)
        && (data.get('employeeFirestoreId', '') == employeeId()
          || data.get('employeeId', '') == employee(companyId).data.get('employeeId', ''));
    }
    function validEmployeeAdvanceUpdate(companyId) {
      return ownAdvance(companyId, resource.data)
        && resource.data.status == 'Pending'
        && request.resource.data.status == 'Pending'
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.employeeFirestoreId == resource.data.employeeFirestoreId
        && request.resource.data.get('payoutStatus', 'NOT_INITIATED') == resource.data.get('payoutStatus', 'NOT_INITIATED')
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'advanceType', 'amount', 'monthlyDeduction', 'months', 'interest', 'remainingAmount',
          'repaymentMethod', 'firstDeductionDate', 'expectedCompletion', 'reason', 'projectId',
          'projectName', 'purpose', 'requiredDate', 'description', 'priority', 'updatedAt'
        ]);
    }
    function validAdvanceEditorUpdate(companyId) {
      return (has(companyId, 'advance.manage') || (has(companyId, 'advance.approve') && has(companyId, 'advance.edit')))
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.employeeFirestoreId == resource.data.employeeFirestoreId
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('payoutStatus', 'NOT_INITIATED') == resource.data.get('payoutStatus', 'NOT_INITIATED')
        && ((resource.data.status == 'Pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'advanceType', 'amount', 'monthlyDeduction', 'months', 'interest', 'remainingAmount',
            'settledAmount', 'repaymentMethod', 'firstDeductionDate', 'expectedCompletion', 'reason',
            'projectId', 'projectName', 'purpose', 'requiredDate', 'description', 'priority',
            'managerRemarks', 'updatedAt'
          ]))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reason', 'projectName', 'purpose', 'requiredDate', 'description', 'priority',
            'managerRemarks', 'updatedAt'
          ]));
    }
    function validAdvanceSettlement(companyId) {
      return (has(companyId, 'advance.manage') || (has(companyId, 'advance.approve') && has(companyId, 'advance.edit')))
        && resource.data.status == 'Approved'
        && request.resource.data.status == 'Settled'
        && request.resource.data.remainingAmount == 0
        && request.resource.data.settledAmount is number
        && request.resource.data.settledAmount >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settledAmount', 'remainingAmount', 'status', 'updatedAt']);
    }
    function keepsGpsReviewServerOwned() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'reviewStatus', 'approvalStatus', 'decision', 'reviewRemarks', 'reviewedByUid',
        'reviewedByName', 'reviewedByRole', 'reviewedAt'
      ]);
    }
    function keepsLeaveDecisionServerOwned() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status', 'decision', 'managerRemarks', 'reviewedByUid', 'reviewedByName',
        'reviewedByRole', 'reviewedAt'
      ]);
    }
    function keepsTrustedAttendanceServerOwned() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'hardwareVerified', 'hardwarePunchCount', 'hardwareEventIds', 'hardwareDeviceId',
        'correctedByUid', 'correctedByName', 'correctedByRole', 'correctedAt'
      ]);
    }
    function validVendorPaymentClientWrite() {
      return request.resource.data.paymentSource == 'project_vendor'
        && (!('purchaseOrderId' in request.resource.data) || request.resource.data.purchaseOrderId == '')
        && (!('purchaseOrderBillId' in request.resource.data) || request.resource.data.purchaseOrderBillId == '')
        && (!('purchaseOrderNumber' in request.resource.data) || request.resource.data.purchaseOrderNumber == '')
        && (!('purchaseOrderBillNumber' in request.resource.data) || request.resource.data.purchaseOrderBillNumber == '')
        && (!('billTotal' in request.resource.data) || request.resource.data.billTotal == 0)
        && (!('billPaidAmount' in request.resource.data) || request.resource.data.billPaidAmount == 0)
        && (!('billOutstandingAmount' in request.resource.data) || request.resource.data.billOutstandingAmount == 0);
    }

    match /Usermanagement/{userId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /PayoutTransferIndex/{transferId} { allow read, write: if false; }
    match /PayoutWebhookEvents/{eventId} { allow read, write: if false; }
    match /Companies/{companyId} {
      allow read: if companyMember(companyId);
      allow update: if has(companyId, 'company.manage')
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow create, delete: if false;

      match /Usermanagement/{userId} {
        allow read: if active(companyId) && (isOwner(companyId) || employeeId() == userId || has(companyId, 'employee.view') || has(companyId, 'employee.manage'));
        allow create, delete: if false;
        allow update: if request.resource.data.get('payoutBeneficiary', null) == resource.data.get('payoutBeneficiary', null)
          && ((has(companyId, 'employee.edit')
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.firestoreId == resource.data.firestoreId
            && request.resource.data.employeeId == resource.data.employeeId
            && request.resource.data.access == resource.data.access
            && request.resource.data.login == resource.data.login)
          || (employeeId() == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access', 'updatedAt'])
            && request.resource.data.access.diff(resource.data.access).affectedKeys().hasOnly(['policyAccepted', 'lastLoginAt', 'lastDevice', 'lastBrowser', 'lastLocation'])));
      }
      // Employee mobile views use the employee-scoped mirrors. Keep these reads
      // limited to the authenticated employee's own document; server callables
      // remain the only writers for the mirrors.
      match /Usermanagement/{userId}/Attendance/{id} {
        allow read: if active(companyId) && (isOwner(companyId) || employeeId() == userId);
        allow write: if false;
      }
      match /Usermanagement/{userId}/WorkLogs/{id} {
        allow read: if active(companyId) && (isOwner(companyId) || employeeId() == userId);
        allow write: if false;
      }
      match /Usermanagement/{userId}/Expenses/{id} {
        allow read: if active(companyId) && (isOwner(companyId) || employeeId() == userId);
        allow write: if false;
      }
      match /Roles/{roleId} { allow read: if active(companyId); allow write: if false; }
      match /Permissions/{permissionId} { allow read: if active(companyId); allow write: if false; }
      match /ActivityLogs/{logId} { allow read: if has(companyId, 'employee.manage'); allow create: if active(companyId) && request.resource.data.actorId == request.auth.uid; allow update, delete: if false; }

      match /Attendance/{id} {
        allow read: if has(companyId, 'attendance.view');
        allow create: if canWrite(companyId, 'attendance');
        allow update: if canWrite(companyId, 'attendance') && keepsTrustedAttendanceServerOwned();
        allow delete: if canWrite(companyId, 'attendance');
      }
      match /HardwareAttendanceEvents/{id} { allow read: if has(companyId, 'attendance.view'); allow write: if false; }
      match /GPSPunches/{id} {
        allow read: if isOwner(companyId) || has(companyId, 'gps.view');
        allow create: if canWrite(companyId, 'gps');
        allow update: if canWrite(companyId, 'gps') && keepsGpsReviewServerOwned();
        allow delete: if canWrite(companyId, 'gps');
      }
      match /LeaveRequests/{id} {
        allow read: if isOwner(companyId) || has(companyId, 'leave.view')
          || (active(companyId) && resource.data.employeeId == employeeId());
        allow create: if canWrite(companyId, 'leave') && request.resource.data.get('status', 'Pending') == 'Pending';
        allow update: if canWrite(companyId, 'leave') && keepsLeaveDecisionServerOwned();
        allow delete: if canWrite(companyId, 'leave');
      }
      match /LeaveTypes/{id} { allow read: if has(companyId, 'leave.view'); allow write: if has(companyId, 'leave.manage'); }
      match /Holidays/{id} { allow read: if active(companyId); allow write: if has(companyId, 'leave.manage'); }
      match /ShiftPolicies/{id} { allow read: if active(companyId); allow write: if has(companyId, 'settings.manage'); }
      match /advance_requests/{id} {
        allow read: if isOwner(companyId) || has(companyId, 'advance.approve') || has(companyId, 'advance.manage') || canonicalEmployeeAdvanceRead(companyId, resource.data);
        allow create: if false;
        allow update: if validEmployeeAdvanceUpdate(companyId) || validAdvanceEditorUpdate(companyId) || validAdvanceSettlement(companyId);
        allow delete: if has(companyId, 'advance.delete') || has(companyId, 'advance.manage');
      }
      match /ExpenseCategories/{id} {
        allow read: if active(companyId);
        allow write: if false;
      }
      match /ExpensePeriods/{periodId} {
        allow read: if has(companyId, 'expense.view');
        allow write: if false;
      }
      match /ExpenseCreateRequests/{id} { allow read, write: if false; }
      match /ExpenseCategoryNames/{id} { allow read, write: if false; }
      match /Expenses/{id}/Reimbursements/{reimbursementId} { allow read, write: if false; }
      match /Expenses/{id}/EditHistory/{historyId} { allow read: if isOwner(companyId); allow write: if false; }
      match /Expenses/{id} {
        allow read: if ownExpense(companyId, resource.data)
          || (has(companyId, 'expense.view') && (managerScope(companyId) || ownExpense(companyId, resource.data)));
        // Keep Flutter's legacy create authorization, evaluating account activity once.
        allow create: if request.resource.data.get('reimbursed', false) == false
          && request.resource.data.get('reimbursedAmount', 0) == 0
          && request.resource.data.get('reimbursementStatus', 'unpaid') == 'unpaid'
          && request.resource.data.get('reimbursable', true) == true
          && !request.resource.data.keys().hasAny(['reimbursedAt', 'reimbursedBy', 'outstandingAmount', 'reimbursement', 'reimbursementLedgerVersion', 'reconciliationRequired'])
          && (!('date' in request.resource.data) || !exists(/databases/$(database)/documents/Companies/$(companyId)/ExpensePeriods/$(expensePeriodId(request.resource.data.date))) || get(/databases/$(database)/documents/Companies/$(companyId)/ExpensePeriods/$(expensePeriodId(request.resource.data.date))).data.get('status', 'open') != 'locked')
          && (isOwner(companyId) || (active(companyId)
          && ('expense.create' in employee(companyId).data.access.effectivePermissions
            || 'expense.manage' in employee(companyId).data.access.effectivePermissions)
          && (employee(companyId).data.access.roleId != 'employee'
            || request.resource.data.employeeId == employee(companyId).data.get('employeeId', ''))));
        // Mutations must use the trusted API/callable to preserve decisions, policy and mirrors.
        allow update, delete: if false;
      }
      match /Projectmanagement/{id} { allow read: if has(companyId, 'projects.view'); allow write: if canWrite(companyId, 'projects'); }
      match /WorkLogs/{id} { allow read: if isOwner(companyId) || has(companyId, 'projects.view'); allow write: if canWrite(companyId, 'projects'); }
      match /Clients/{id} { allow read: if has(companyId, 'clients.view'); allow write: if canWrite(companyId, 'clients'); }
      match /Vendors/{id} { allow read: if has(companyId, 'vendors.view'); allow write: if canWrite(companyId, 'vendors'); }
      match /VendorPayments/{id} {
        allow read: if has(companyId, 'vendors.view');
        allow create, update: if canWrite(companyId, 'vendors') && validVendorPaymentClientWrite();
        allow delete: if canWrite(companyId, 'vendors');
      }
      match /Invoices/{id} { allow read: if has(companyId, 'invoices.view') || has(companyId, 'billing.view'); allow write: if canWrite(companyId, 'invoices') || canWrite(companyId, 'billing'); }
      match /Payments/{id} { allow read: if has(companyId, 'billing.view'); allow write: if canWrite(companyId, 'billing'); }
      match /PayoutSettings/{id} {
        allow read, write: if false;
      }
      match /Payouts/{id} {
        allow read: if isOwner(companyId) || has(companyId, 'advance.approve') || has(companyId, 'advance.manage') || ownAdvance(companyId, resource.data);
        allow write: if false;
      }
      match /Quotations/{id} { allow read: if has(companyId, 'quotation.view'); allow write: if canWrite(companyId, 'quotation'); }
      match /QuotationSettings/{id} { allow read, write: if false; }
      match /Payrolls/{id} { allow read: if ownPayroll(companyId, resource.data) || has(companyId, 'payroll.view'); allow write: if false; }
      // Legacy Flutter clients still address this collection; keep it
      // self-read-only while production writes remain canonical in Payrolls.
      match /Payroll/{id} { allow read: if ownPayroll(companyId, resource.data) || has(companyId, 'payroll.view'); allow write: if false; }
      match /Notifications/{id} {
        allow read: if notificationAudience(companyId);
        allow write: if has(companyId, 'notifications.manage') && request.resource.data.companyId == companyId;
      }
      match /UserNotifications/{userId} {
        allow read: if ownNotificationNamespace(companyId, userId);
        allow write: if false;

        match /Items/{itemId} {
          allow read: if ownNotificationNamespace(companyId, userId);
          allow create: if ownNotificationNamespace(companyId, userId) && validNotificationStateCreate();
          allow update: if ownNotificationNamespace(companyId, userId) && validNotificationStateUpdate();
          allow delete: if false;
        }
      }
      match /{collection}/{document} {
        allow read, write: if isOwner(companyId) && !(collection in ['PayoutSettings', 'Payouts', 'Usermanagement', 'advance_requests', 'UserNotifications', 'Roles', 'Permissions', 'QuotationSettings', 'ExpenseCategories', 'ExpenseCategoryNames', 'ExpenseCreateRequests', 'Expenses']);
      }
      match /{collection}/{document}/{nested=**} {
        allow read, write: if isOwner(companyId) && !(collection in ['PayoutSettings', 'Payouts', 'Usermanagement', 'advance_requests', 'UserNotifications', 'Roles', 'Permissions', 'QuotationSettings', 'ExpenseCategories', 'ExpenseCategoryNames', 'ExpenseCreateRequests', 'Expenses']);
      }
    }
  }
}

// force rules release 2026-09-22
